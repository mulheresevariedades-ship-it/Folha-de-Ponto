{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/ponto-digital run build && pnpm --filter @workspace/api-server run build && node scripts/portable/fetch-tessdata.mjs --destino artifacts/api-server/dist/ocr/tessdata",
  "outputDirectory": "artifacts/ponto-digital/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "artifacts/api-server/dist/ocr/**"
    }
  },
  "build": {
    "env": {
      "PORT": "3000",
      "BASE_PATH": "/"
    }
  }
}
