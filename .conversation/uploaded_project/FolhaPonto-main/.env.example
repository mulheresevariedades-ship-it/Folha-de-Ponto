# Chave secreta para JWT (troque em produção)
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-de-64-caracteres

# Algoritmo JWT
JWT_ALGORITHM=HS256

# Tempo de expiração da sessão em minutos
JWT_EXPIRATION_MINUTES=480

# Usuário administrador inicial (criado no primeiro startup)
ADMIN_USERNAME=admin@undf.edu.br
ADMIN_PASSWORD=mude-esta-senha

# Senha do banco de dados do usuário admin (hash bcrypt)
# Se vazio, usa a variável ADMIN_PASSWORD acima

# Tesseract (opcional - caminho do executável)
# TESSERACT_CMD=/usr/bin/tesseract

# Senha de criptografia do CPF (chave Fernet de 32 bytes, base64)
# Se vazio, o CPF fica mascarado mas não criptografado
CPF_ENCRYPTION_KEY=
