{
  "buildCommand": "pip install -r requirements.txt && python -c 'from server import app; print(\"Build successful\")'",
  "framework": "python",
  "runtime": "python@3.12",
  "functions": {
    "api/index.py": {
      "memory": 3008,
      "maxDuration": 60,
      "includeFiles": "**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "outputDirectory": ".vercel/output"
}
