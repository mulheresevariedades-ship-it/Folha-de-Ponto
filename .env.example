# Copie este arquivo para .env (não versionado) e preencha com suas credenciais.
# Nunca commite o .env: ele contém senhas reais.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/DATABASE?sslmode=require
PORT=4000

# Chave de criptografia de dados sensíveis (CPF dos servidores e senha SMTP).
# Obrigatória: sem ela, importar servidores com CPF e buscar por CPF falham.
# Gere uma aleatória, por exemplo 64 caracteres hexadecimais.
SESSION_SECRET=

# Arquivo permanente de PDFs em bucket S3-compatível (Cloudflare R2, AWS S3, MinIO).
# Se S3_BUCKET, S3_ACCESS_KEY_ID e S3_SECRET_ACCESS_KEY não estiverem definidos,
# o sistema usa a pasta de dados local (modo portátil) como antes.
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=ponto-digital
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# SMTP (opcional — fallback das variáveis sobre o banco)
# SMTP_HOST=smtp.exemplo.gov.br
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASSWORD=
# SMTP_FROM=remetente@exemplo.gov.br
# SMTP_SECURE=false
